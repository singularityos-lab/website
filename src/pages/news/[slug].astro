---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('news', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

const url = new URL(`/news/${post.id}/`, Astro.site).href;
const enc = encodeURIComponent;
const tw = `https://twitter.com/intent/tweet?text=${enc(post.data.title)}&url=${enc(url)}`;
const wa = `https://wa.me/?text=${enc(post.data.title + ' ' + url)}`;
const tg = `https://t.me/share/url?url=${enc(url)}&text=${enc(post.data.title)}`;
---

<Base title={`${post.data.title} - Singularity OS`} description={post.data.description}>
  <header class="post-cover">
    <div class="post-cover-inner">
      <a class="post-back" href="/news">Back to news</a>
      <div class="post-date">{fmt(post.data.date)}</div>
      <h1 class="post-title">{post.data.title}</h1>
    </div>
  </header>
  <article class="post">
    <div class="post-body">
      <Content />
    </div>
    <div class="post-share" aria-label="Share this post">
      <a class="share-btn" href={tw} target="_blank" rel="noopener" aria-label="Share on X">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <a class="share-btn" href={wa} target="_blank" rel="noopener" aria-label="Share on WhatsApp">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.978-1.043zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
      </a>
      <a class="share-btn" href={tg} target="_blank" rel="noopener" aria-label="Share on Telegram">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.139-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
      </a>
      <button class="share-btn" type="button" id="copyUrlBtn" aria-label="Copy link">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg>
      </button>
    </div>
  </article>

  <style>
    .post { max-width: 1220px; padding-left: 0; padding-right: 0; }
    .post-cover-inner { max-width: 840px; }
    .post-title,
    .post-date { text-align: center; }
    .post-body {
      display: flex;
      flex-direction: column;
      align-items: center;
      align-content: center;
    }
    .post-body > :global(*) {
      display: block;
      width: 100%;
      max-width: 840px;
      padding-left: 20px;
      padding-right: 20px;
    }
    .post-body > :global(p:has(img)) { max-width: 1220px; padding-left: 0; padding-right: 0; }
    .post-body :global(img) {
      display: block;
      width: 100%;
      height: auto;
      margin: 28px auto;
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 4px;
    }
    .post-share { max-width: 840px; margin-left: auto; margin-right: auto; padding-left: 20px; padding-right: 20px; }
  </style>

  <script is:inline>
    (function () {
      var b = document.getElementById('copyUrlBtn');
      if (!b) return;
      b.addEventListener('click', function () {
        navigator.clipboard.writeText(location.href).then(function () {
          b.classList.add('copied');
          setTimeout(function () { b.classList.remove('copied'); }, 1200);
        });
      });
    })();
  </script>
</Base>
