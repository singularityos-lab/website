  <script is:inline>
    (function () {
      var cc = document.querySelector('.sb-illus .cc');
      var row = document.getElementById('accentRow');
      var picker = document.getElementById('accentPicker');
      var custom = document.getElementById('accentCustom');
      if (!cc || !row) return;
      function setAccent(c, dot) {
        cc.style.setProperty('--cc-accent', c);
        var all = row.querySelectorAll('.accent-dot');
        for (var i = 0; i < all.length; i++) all[i].classList.remove('active');
        if (dot) dot.classList.add('active');
      }
      row.addEventListener('click', function (e) {
        var d = e.target.closest('.accent-dot');
        if (!d) return;
        if (d === custom) { if (picker) picker.click(); return; }
        var c = d.getAttribute('data-accent');
        if (c) setAccent(c, d);
      });
      if (picker) picker.addEventListener('input', function () { setAccent(picker.value, custom); });
      var first = row.querySelector('.accent-dot[data-accent="#3584e4"]');
      if (first) first.classList.add('active');
    })();
  </script>
