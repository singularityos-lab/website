  <script is:inline>
    (function () {
      var slide = document.getElementById('ccSlide');
      if (!slide) return;
      var search = document.querySelector('.cc-settings .set-search');
      var q = document.getElementById('setQ');
      var list = document.getElementById('setList');
      var res = document.getElementById('setResults');
      var t = [];
      function clearAll() { t.forEach(clearTimeout); t = []; }
      function after(ms, fn) { t.push(setTimeout(fn, ms)); }
      function reset() {
        slide.classList.remove('show2');
        if (search) search.classList.remove('typing', 'has-q');
        if (q) q.textContent = '';
        if (list) list.hidden = false;
        if (res) res.hidden = true;
      }
      function typeText(text, done) {
        if (search) search.classList.add('typing');
        var i = 0;
        (function step() {
          if (q) q.textContent = text.slice(0, i);
          if (i++ < text.length) after(150, step);
          else { if (search) { search.classList.remove('typing'); search.classList.add('has-q'); } done(); }
        })();
      }
      function cycle() {
        clearAll();
        reset();
        after(3000, function () { slide.classList.add('show2'); });
        after(6700, function () {
          typeText('dock', function () {
            if (list) list.hidden = true;
            if (res) res.hidden = false;
            after(2800, function () {
              if (search) search.classList.remove('has-q');
              if (q) q.textContent = '';
              if (res) res.hidden = true;
              if (list) list.hidden = false;
              after(500, function () { slide.classList.remove('show2'); });
              after(4200, cycle);
            });
          });
        });
      }
      var ANIMATE = true;
      if (ANIMATE) cycle();
    })();
  </script>

