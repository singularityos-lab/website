---
import '@fontsource-variable/montserrat';
import '../styles/tokens.css';
import '../styles/landing.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const { title = 'Singularity OS', description = 'Singularity OS - A new operating system.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Mirko Brombin" />
    <link rel="icon" href="/icon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Singularity OS - News" href="/rss.xml" />
  </head>
  <body style="display:flex;flex-direction:column">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline src="/ctxmenu.js" defer></script>
  </body>
</html>
